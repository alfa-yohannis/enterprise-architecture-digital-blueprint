      </child>
      <child xsi:type="archimate:DiagramObject" id="id-view-proses-proses-ingat" targetConnections="id-view-proses-r06 id-view-proses-r08" archimateElement="id-proses-ingat">
        <bounds x="420" y="140" width="150" height="55"/>
